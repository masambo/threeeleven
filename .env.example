# Convex (packages/backend)
CONVEX_DEPLOYMENT=
CONVEX_URL=http://127.0.0.1:3210
CONVEX_SITE_URL=http://127.0.0.1:3210
CLERK_JWT_ISSUER_DOMAIN=

# Admin web (apps/admin-web/.env.local)
NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Super admin web (apps/super-admin-web/.env.local)
# Same Clerk and Convex variables as admin-web

# Mobile (apps/user-mobile/.env.local)
EXPO_PUBLIC_CONVEX_URL=http://127.0.0.1:3210
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
